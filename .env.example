# Server Configuration
PORT=5050
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Gemini API Configuration
# Documented models: Generation: gemini-3.5-flash (or gemini-3.8-flash), Embedding: gemini-embedding-001
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768

# Vector Store Selection: "inmemory" or "mongo"
VECTOR_STORE=inmemory

# MongoDB Atlas Configuration (Required if VECTOR_STORE=mongo)
MONGODB_URI=your_mongodb_connection_string_here
MONGODB_DB_NAME=interview_rag
MONGODB_COLLECTION=kb_chunks
MONGODB_INDEX_NAME=vector_index

# RAG & Retrieval Configuration
# PROVISIONAL — will be replaced after retrieval evaluation in Phase 5
SIMILARITY_THRESHOLD=0.65
DEFAULT_CHUNK_SIZE=600
DEFAULT_CHUNK_OVERLAP=100
TOP_K=5
